[Unit]
Description=node0 P2P Agent Mesh Protocol Server
After=network.target

[Service]
# Adjust the user under which the service should run (e.g., node0, www-data, or root)
User=root

# Path to the directory containing main.py
WorkingDirectory=/opt/node0

# Load environment configuration (database paths, LNBits keys, etc.)
EnvironmentFile=/opt/node0/.env

# Command to execute (uses uvicorn inside the python virtual environment)
ExecStart=/opt/node0/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1

# Restart behavior in case the service crashes or fails
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
